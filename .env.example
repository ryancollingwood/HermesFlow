# =============================================================================
#  Copy to `.env` and fill in. Keep `.env` out of git and chmod 600 it —
#  every value here is visible via `docker inspect`, so treat it as secret.
# =============================================================================

# --- Paths ------------------------------------------------------------------
# NOTE: Docker Compose does NOT expand `~`. It DOES expand ${HOME}.
# If ${HOME} ever misbehaves, just hardcode absolute paths.
# Hermes maps this WHOLE directory to /opt/data (config, .env, sessions, etc).
DATA_DIR=${HOME}/.hermes
SHARED_DIR=${HOME}/.shared_agent_data
WM_DATA_DIR=${HOME}/.windmill

# --- Ingress (Caddy) --------------------------------------------------------
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_DATA_DIR=${HOME}/.caddy/data
CADDY_CONFIG_DIR=${HOME}/.caddy/config

# --- Hermes -----------------------------------------------------------------
# Pin to a tagged release for production rather than latest.
HERMES_VERSION=latest

# Host bind for the Hermes ports.
# 127.0.0.1 = localhost only (safe default, no LAN exposure).
# 0.0.0.0   = all interfaces — only safe on a trusted LAN or behind Caddy.
#             With HERMES_DASHBOARD_INSECURE=1 this exposes API keys and session
#             data to anyone who can reach port 9119, so think before opening it.
HERMES_BIND=127.0.0.1
API_SERVER_PORT=8642

# Set to your host user's IDs so the container can write to the bind-mounted
# /opt/data directory.  Run `id -u` and `id -g` to find the right values.
HERMES_UID=1000
HERMES_GID=1000

# Dashboard (built into the gateway container)
# HERMES_DASHBOARD=1 enables the web UI served on HERMES_DASHBOARD_PORT.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
# HERMES_DASHBOARD_INSECURE=1 drops the OAuth gate entirely.
# Safe only behind Caddy or on a fully trusted LAN — the dashboard shows raw
# API keys, session history, and memory content to unauthenticated visitors.
# Leave blank (or unset) to keep the OAuth gate active.
HERMES_DASHBOARD_INSECURE=

# OpenAI-compatible API server. Enabled so the dashboard + Windmill flows can
# call the gateway at http://hermes:8642/v1. API_SERVER_KEY is REQUIRED when
# enabled (>= 8 chars) — run `make apikey` to generate one, or:
#   openssl rand -hex 32
# Setting API_SERVER_ENABLED=false disables the HTTP API entirely; the gateway
# still runs but is only reachable by the s6-supervised dashboard process.
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY=

# Resource caps. Browser tools (Playwright/Chromium) are memory-hungry — use
# 2–4G if you use them, 1G if you don't.
HERMES_MEM_LIMIT=2G
HERMES_CPU_LIMIT=2.0

# --- Hermes: provider keys / bot tokens -------------------------------------
# By default these are set via the first-run wizard (written to ~/.hermes/.env).
# Only fill these in if you uncomment the matching lines in docker-compose.yml
# to forward them instead.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# --- Windmill ---------------------------------------------------------------
# Recommend pinning to a tagged release instead of :main for reproducibility,
# e.g. ghcr.io/windmill-labs/windmill:1.x.x  (and match WM_LSP_IMAGE to it).
WM_IMAGE=ghcr.io/windmill-labs/windmill:main
WM_LSP_IMAGE=ghcr.io/windmill-labs/windmill-lsp:latest
WM_PORT=8000
WM_DB_PASSWORD=change-me-too
WM_BASE_URL=http://windmill.localhost
# Bind-mount path for the LSP cache (was a named volume).
WM_LSP_CACHE_DIR=${HOME}/.windmill/lsp_cache

# --- Monitoring (Prometheus + Grafana) --------------------------------------
# Shared root for all monitoring state (prometheus TSDB + grafana DB).
MONITORING_DATA_DIR=${HOME}/.monitoring

# How long Prometheus keeps raw metrics on disk. Longer = more disk usage.
# 15d covers two sprint cycles; bump to 30d+ on a dedicated node.
PROMETHEUS_RETENTION=15d

# Grafana admin credentials — change before exposing to a network.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Image version pins — leave blank or "latest" to always pull the newest.
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
CADVISOR_VERSION=latest
NODE_EXPORTER_VERSION=latest
PG_EXPORTER_VERSION=latest

# --- Hindsight (personal second-brain memory) --------------------------------
# Embedded PostgreSQL data directory inside the container is /home/hindsight/.pg0.
HINDSIGHT_DATA_DIR=${HOME}/.hindsight

# Host bind and ports for direct access outside of Caddy.
# 127.0.0.1 = localhost only. 0.0.0.0 = all interfaces (LAN-visible).
HINDSIGHT_BIND=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_UI_PORT=9999

# Optional bearer token to protect the Hindsight API.
# Leave blank for local-only access (no auth). Set a secret if you open the
# port beyond localhost or proxy it through Caddy.
HINDSIGHT_API_KEY=

# Internal URL that Hermes uses to reach the Hindsight API.
# Only change this if you rename the hindsight container or move it off-stack.
HINDSIGHT_BASE_URL=http://hindsight:8888

# LLM used for memory extraction and synthesis.
# Defaults to the Ollama container (OpenAI-compatible /v1 endpoint).
# To use LM Studio on the host instead, set BASE_URL to
#   http://host.docker.internal:1234/v1
# and keep PROVIDER=openai (LM Studio exposes an OpenAI-compatible API).
# NOTE: Use PROVIDER=openai (not ollama) even when pointing at Ollama's /v1 —
#   setting PROVIDER=ollama makes Hindsight call /api/chat instead of
#   /v1/chat/completions, which is the raw Ollama API, not the OpenAI shim.
HINDSIGHT_LLM_API_KEY=ollama
HINDSIGHT_LLM_BASE_URL=http://ollama:11434/v1
HINDSIGHT_LLM_MODEL=llama3.2:3b
HINDSIGHT_LLM_PROVIDER=openai

# Response format sent to the LLM for structured fact extraction.
# json_schema works with Ollama ≥0.3 and LM Studio; fall back to json if your
# model/version doesn't support it.
HINDSIGHT_LLM_RESPONSE_FORMAT=json_schema

# HTTP timeout (seconds) for LLM calls during memory extraction.
# Large models on CPU can take minutes per request — set generously.
# Leave blank to use the image default (~360s).
HINDSIGHT_LLM_TIMEOUT=

# Max concurrent LLM requests issued by Hindsight. Drop to 1–2 when pointing
# at a local Ollama backend (it can only serve one request at a time on CPU).
HINDSIGHT_LLM_MAX_CONCURRENT=2

# Reasoning effort for models that support it (low / medium / high).
# low = fastest, least token spend. Only relevant for o-series / reasoning models.
HINDSIGHT_LLM_REASONING_EFFORT=low

# ── Per-operation LLM overrides ──────────────────────────────────────────────
# Leave blank to inherit the defaults above. Useful if you want a fast cheap
# model for retain (high-volume fact extraction) and a smarter one for reflect
# (synthesis / insight generation) or consolidation (dedup / merge).
#
# Each operation accepts _PROVIDER, _API_KEY, and _MODEL.
# Example: use a remote API just for reflect while retain stays local:
#   HINDSIGHT_REFLECT_LLM_PROVIDER=openai
#   HINDSIGHT_REFLECT_LLM_API_KEY=sk-...
#   HINDSIGHT_REFLECT_LLM_MODEL=gpt-4o-mini
HINDSIGHT_RETAIN_LLM_PROVIDER=
HINDSIGHT_RETAIN_LLM_API_KEY=
HINDSIGHT_RETAIN_LLM_MODEL=
HINDSIGHT_REFLECT_LLM_PROVIDER=
HINDSIGHT_REFLECT_LLM_API_KEY=
HINDSIGHT_REFLECT_LLM_MODEL=
HINDSIGHT_CONSOLIDATION_LLM_PROVIDER=
HINDSIGHT_CONSOLIDATION_LLM_API_KEY=
HINDSIGHT_CONSOLIDATION_LLM_MODEL=

# ── Embeddings ───────────────────────────────────────────────────────────────
# Provider for generating vector embeddings used in semantic search.
# local    = bundled HuggingFace model, no external calls (default)
# openai   = OpenAI text-embedding-3-* (requires OPENAI_API_KEY)
# tei      = Text Embeddings Inference server (self-hosted)
# cohere   = Cohere Embed API
HINDSIGHT_EMBEDDINGS_PROVIDER=local

# Model used when EMBEDDINGS_PROVIDER=local.
# bge-small-en-v1.5 (default) — fast, 33M params, English-only.
# BAAI/bge-m3 — larger, multilingual, much better recall quality.
# BAAI/bge-large-en-v1.5 — best English quality, ~335M params.
HINDSIGHT_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5

# ── Reranker ─────────────────────────────────────────────────────────────────
# Reranking re-scores the top-N recall candidates using a cross-encoder for
# much better precision than vector similarity alone.
# local    = bundled cross-encoder model (default, no external calls)
# tei      = Text Embeddings Inference server
# cohere   = Cohere Rerank API
HINDSIGHT_RERANKER_PROVIDER=local

# Cross-encoder model used when RERANKER_PROVIDER=local.
# ms-marco-MiniLM-L-6-v2 (default) — fast, good quality for English.
# cross-encoder/ms-marco-MiniLM-L-12-v2 — slower but better quality.
HINDSIGHT_RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Concurrency cap for the local reranker (cross-encoder is CPU-bound).
HINDSIGHT_RERANKER_MAX_CONCURRENT=4

# How many candidates to fetch before reranking. Higher = better coverage at
# the cost of more reranker compute. 300 is a sensible default.
HINDSIGHT_RERANKER_MAX_CANDIDATES=300

# ── Retain pipeline ──────────────────────────────────────────────────────────
# How content is decomposed into facts during a retain operation.
# concise  — compact facts, fewer LLM calls (default, good for CPU inference)
# verbose  — richer facts, more LLM calls, better recall on nuanced queries
# verbatim — store text as-is without LLM extraction (fastest, lowest quality)
# chunks   — split into fixed-size chunks, no LLM extraction
HINDSIGHT_RETAIN_EXTRACTION_MODE=concise

# Max characters per extraction chunk fed to the LLM.
# Smaller = finer-grained facts but more LLM calls; larger = fewer calls but
# the model may miss detail buried in long passages.
HINDSIGHT_RETAIN_CHUNK_SIZE=3000

# Extract causal/relationship edges during retain (e.g. "A caused B").
# Disable to reduce LLM calls if you only need factual recall, not graph queries.
HINDSIGHT_RETAIN_EXTRACT_CAUSAL_LINKS=true

# ── Retrieval ────────────────────────────────────────────────────────────────
# Cosine similarity threshold for semantic search. Hits below this score are
# discarded before reranking. Lower = broader (noisier); 0.5+ = stricter.
HINDSIGHT_SEMANTIC_MIN_SIMILARITY=0.3

# Max concurrent recall (retrieval) requests.
HINDSIGHT_RECALL_MAX_CONCURRENT=32

# ── Server ───────────────────────────────────────────────────────────────────
# Uvicorn worker processes. 1 is safe for single-user local use.
# Increase on a multi-core machine if you have concurrent callers.
HINDSIGHT_WORKERS=1

# Resource caps.
HINDSIGHT_MEM_LIMIT=2G
HINDSIGHT_CPU_LIMIT=1.0

# --- Ollama (local LLM inference) -------------------------------------------
# Pin to a tagged release for production, e.g. OLLAMA_VERSION=0.3.12
OLLAMA_VERSION=latest

# Storage path for downloaded model weights (can be several GB per model).
OLLAMA_DATA_DIR=${HOME}/.ollama

# Host bind and port for direct access outside of Caddy.
# 127.0.0.1 = localhost only. Change to 0.0.0.0 only if you need LAN access.
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434

# How long to keep a loaded model in memory after the last request.
# Examples: 5m, 1h, -1 (keep forever).
# 30m keeps the model warm on an always-on node without holding RAM indefinitely.
# Use -1 on a dedicated inference box where you want zero reload latency.
OLLAMA_KEEP_ALIVE=30m

# CPU threads for llama.cpp matrix ops. Set to physical P-core count for best
# throughput — AVX_VNNI runs on P-cores; E-cores add latency without bandwidth.
# Intel Core Ultra 5 125H: 4 P-cores × 2 HT = 8. Leaves E-cores free for the stack.
OLLAMA_NUM_THREAD=8

# Context window size (tokens). Larger = more memory per request.
# 16384 is a safe default for 16–32 GB RAM. Bump to 32768 for long-document
# tasks if you have headroom, or reduce to 8192 to fit more models simultaneously.
OLLAMA_CONTEXT_LENGTH=16384

# Max concurrent inference requests. CPU inference doesn't benefit from
# parallelism — keep at 1 unless you have GPU with enough VRAM to batch.
OLLAMA_NUM_PARALLEL=1

# Max models to keep loaded simultaneously. Each loaded model holds its full
# weight in RAM. Increase only if you have RAM to spare and switch models often.
OLLAMA_MAX_LOADED_MODELS=1

# Resource caps — 32G covers 32B Q4_K_M (~20 GB) with KV-cache headroom.
# Increase to 48G to fit 70B IQ2_XS (~25 GB), though 1–3 tok/s may not justify it.
OLLAMA_MEM_LIMIT=32G
# 8 CPU units = P-core threads; leaves E-cores + LPE for the rest of the stack.
OLLAMA_CPU_LIMIT=8.0

# Set to 1 to enable Intel Arc iGPU inference (SYCL, experimental).
# Disabled: 2 GB VRAM limits the iGPU to <3B models; CPU handles larger models better.
OLLAMA_INTEL_GPU=0

# Enable Vulkan GPU backend (cross-vendor, experimental).
# false = disabled. Set true only if you have a Vulkan-capable GPU and CUDA is
# unavailable (e.g. AMD on Linux without ROCm).
OLLAMA_VULKAN=false

# GPU device visibility. These control which physical GPU(s) the inference
# backend can see. Leave blank (CPU-only) unless you have a supported GPU.
# To expose a specific GPU, set the relevant variable for your driver:
#   NVIDIA CUDA:  CUDA_VISIBLE_DEVICES=0          (or 0,1 for multi-GPU)
#   AMD ROCm:     ROCR_VISIBLE_DEVICES=0
#   AMD HIP:      HIP_VISIBLE_DEVICES=0
#   Vulkan/GGML:  GGML_VK_VISIBLE_DEVICES=0
#   OpenCL:       GPU_DEVICE_ORDINAL=0
# You must also uncomment the `reservations` block in the ollama service for
# Docker to pass the device through.
CUDA_VISIBLE_DEVICES=
GGML_VK_VISIBLE_DEVICES=
HIP_VISIBLE_DEVICES=
GPU_DEVICE_ORDINAL=
ROCR_VISIBLE_DEVICES=

# Flash attention — reduces memory bandwidth for long contexts.
# Beneficial for hybrid/attention-heavy architectures (e.g. lfm2); harmless for others.
OLLAMA_FLASH_ATTENTION=true

# KV-cache quantisation. q8_0 halves KV-cache RAM vs fp16 with minimal quality
# loss on CPU inference. Use f16 to disable quantisation (higher quality, more RAM).
# Other options: q4_0, q4_1 (more aggressive compression, faster but lower quality).
OLLAMA_KV_CACHE_TYPE=q8_0

# Prompt history — set true to disable saving prompt history to disk.
OLLAMA_NOHISTORY=false

# Blob pruning — set true to prevent Ollama from cleaning up unused model blobs.
# Leave false unless you are manually managing the model store.
OLLAMA_NOPRUNE=false

# ── GPU layer offloading ─────────────────────────────────────────────────────
# Number of model layers to offload to GPU. 0 = CPU-only (explicit, safe default).
# Set to a positive integer (or leave blank for auto-detect) when you have a GPU.
# You must also set the matching device-visibility var above (e.g. CUDA_VISIBLE_DEVICES=0)
# and uncomment the `reservations` block in the ollama service.
OLLAMA_NUM_GPU=0

# Hard cap on VRAM usage in bytes. Prevents Ollama from consuming all GPU memory
# when sharing with other processes. Leave blank for no cap.
# Examples: 4294967296 = 4 GB, 6442450944 = 6 GB, 8589934592 = 8 GB.
OLLAMA_MAX_VRAM=

# How long to wait for a model load before declaring a stall.
# Increase for very large models on slow network-attached or spinning storage.
OLLAMA_LOAD_TIMEOUT=5m
