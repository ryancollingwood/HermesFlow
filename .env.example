# =============================================================================
# HermesFlow — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values marked <REQUIRED>.
# Keep .env out of git (it's in .gitignore) and chmod 600 it —
# every value here is visible via `docker inspect`, so treat it as secret.
#
# PATH NOTES:
#   Mac/Linux : ${HOME} expands correctly. You can also use /absolute/path
#               Docker Compose does NOT expand `~` — use ${HOME} instead.
#   Windows   : Use C:/Users/YourName/HermesFlow/... (forward slashes work in Docker)
#               Do NOT use %USERPROFILE% or backslashes.
#               If ${HOME} resolves to a Windows path in Git Bash / WSL2, hardcode
#               the POSIX form: /c/Users/yourname/...
#               Run fix-permissions.bat after `make init` to resolve errno 13.
# =============================================================================


# =============================================================================
# CORE SETTINGS
# =============================================================================

HERMES_VERSION=latest

# Host user IDs so the container can write to bind-mounted directories.
# Mac/Linux: run `id -u` and `id -g` to find your values.
# Windows: leave as 1000 (Docker Desktop maps to a virtual UID/GID).
HERMES_UID=1000
HERMES_GID=1000

# Resource caps. Browser tools (Playwright/Chromium) are memory-hungry —
# use 2–4G if you use them, 1G if you don't.
HERMES_MEM_LIMIT=2G
HERMES_CPU_LIMIT=2.0

# Persistent data directories.
# Hermes maps DATA_DIR wholesale to /opt/data (config, sessions, memory, etc).
DATA_DIR=${HOME}/HermesFlow/hermes          # Windows: C:/Users/YourName/HermesFlow/hermes
# Mounted as /shared into Hermes and all Windmill services. `artifacts/` is the
# content-addressed artifact store root (see architecture/adr/0003-artifact-lineage-model.md);
# `datalake/` is the data-platform raw layer (docs/plans/datalake.md); and
# `metrics/` holds HF-033's replace-in-place Node Exporter textfile snapshot.
SHARED_DIR=${HOME}/HermesFlow/shared        # Windows: C:/Users/YourName/HermesFlow/shared
# Bind-mounted read-only into Windmill workers as /data_platform — defaults
# to ./data-platform (git-versioned), no override needed unless relocating it.
# DATA_PLATFORM_DIR=./data-platform


# =============================================================================
# AI PROVIDER KEYS
# =============================================================================
# At least one provider key is required for Hermes to function.
# By default these can also be set via the first-run wizard.

# <REQUIRED_if_using_openrouter>
OPENROUTER_API_KEY=            
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


# =============================================================================
# MESSAGING GATEWAY
# =============================================================================
# Add tokens for the platforms you want Hermes to connect to.

# <REQUIRED_if_using_telegram>
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
DISCORD_BOT_TOKEN=


# =============================================================================
# API SERVER & DASHBOARD
# =============================================================================

API_SERVER_ENABLED=true
API_SERVER_PORT=8642
API_SERVER_HOST=0.0.0.0

# Generate with: openssl rand -hex 32
# Required when API_SERVER_ENABLED=true (minimum 8 chars).
# <REQUIRED>
API_SERVER_KEY=

# Host bind for Hermes ports.
# 127.0.0.1 = localhost only (safe default, no LAN exposure).
# 0.0.0.0   = all interfaces — only safe on a trusted LAN or behind Caddy.
#             With HERMES_DASHBOARD_INSECURE=1 this exposes API keys and session
#             data to anyone who can reach the port — think before opening it.
HERMES_BIND=127.0.0.1

# Dashboard (built into the gateway container).
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119

# HERMES_DASHBOARD_INSECURE=1 drops the OAuth gate entirely.
# Safe only behind Caddy or on a fully trusted LAN — the dashboard shows raw
# API keys, session history, and memory content to unauthenticated visitors.
# Leave blank (or unset) to keep the OAuth gate active.
HERMES_DASHBOARD_INSECURE=


# =============================================================================
# WINDMILL
# =============================================================================
# Recommend pinning to a tagged release for reproducibility.

WM_IMAGE=ghcr.io/windmill-labs/windmill:main
WM_LSP_IMAGE=ghcr.io/windmill-labs/windmill-lsp:latest
WM_PORT=8000
WM_BASE_URL=http://windmill.localhost

# Windmill API token that Hermes uses to reach Windmill's native MCP server.
# Scoped to mcp:all (required just to reach the MCP endpoint at all — a separate
# gate from the REST scopes below) plus scripts:read, flows:read, jobs:read,
# jobs:run:scripts, jobs:run:flows (no *:write — write-shaped MCP tools stay
# visible but 403 at call time). Filled in automatically by `make windmill-mcp`
# on first run; reused (and re-verified) on every later run. See
# docs/windmill-sync.md#windmill-mcp-registration.
WM_MCP_TOKEN=

# Dedicated Windmill token used only by HF-028's fixed product-collection MCP
# server. `make hermesflow-mcp` mints/reuses it with jobs:run + jobs:read and
# injects it into that stdio server; it is not exposed to the general MCP tools.
HF_PRODUCT_MCP_TOKEN=

# Generate with: openssl rand -hex 32
# <REQUIRED>
WM_DB_PASSWORD=

# Windows: C:/Users/YourName/HermesFlow/windmill
WM_DATA_DIR=${HOME}/HermesFlow/windmill
WM_LSP_CACHE_DIR=${HOME}/HermesFlow/windmill-cache


# =============================================================================
# CADDY (REVERSE PROXY / TLS)
# =============================================================================

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_DATA_DIR=${HOME}/HermesFlow/caddy/data
CADDY_CONFIG_DIR=${HOME}/HermesFlow/caddy/config


# =============================================================================
# HINDSIGHT (PERSONAL MEMORY / SECOND BRAIN)
# =============================================================================

# ── Infrastructure ────────────────────────────────────────────────────────────
# Hindsight connects to a dedicated hindsight_db Postgres+pgvector container via
# HINDSIGHT_API_DATABASE_URL, built from the HINDSIGHT_DB_* vars below — no more
# embedded pg0.

# Windows: C:/Users/YourName/HermesFlow/hindsight/db
HINDSIGHT_DB_DATA_DIR=${HOME}/HermesFlow/hindsight/db
# Windows: C:/Users/YourName/HermesFlow/hindsight/cache
HINDSIGHT_CACHE_DIR=${HOME}/HermesFlow/hindsight/cache

# Credentials for the hindsight_db Postgres container.
HINDSIGHT_DB_USER=hindsight
# <REQUIRED> Generate: openssl rand -hex 16
HINDSIGHT_DB_PASSWORD=hindsight
HINDSIGHT_DB_NAME=hindsight

# Host bind and ports for direct access outside of Caddy.
HINDSIGHT_BIND=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_UI_PORT=9999

# Optional bearer token to protect the Hindsight API.
# Leave blank for local-only access. Set a secret if you open the port beyond
# localhost or proxy it through Caddy.
HINDSIGHT_API_KEY=

# Internal URL that Hermes uses to reach Hindsight.
# Only change if you rename the container or move it off-stack.
HINDSIGHT_BASE_URL=http://hindsight:8888

# Resource caps.
HINDSIGHT_MEM_LIMIT=8G
HINDSIGHT_CPU_LIMIT=4.0

# Uvicorn worker processes. 1 is safe for single-user local use.
# Increase on a multi-core machine with concurrent callers and a GPU.
HINDSIGHT_WORKERS=1

# ── Primary LLM ───────────────────────────────────────────────────────────────
# Used for all operations unless overridden per-operation below.
#
# NOTE: Use PROVIDER=openai (not ollama) even when pointing at Ollama's /v1 —
#   setting PROVIDER=ollama makes Hindsight call /api/chat instead of
#   /v1/chat/completions, which is the raw Ollama API, not the OpenAI shim.
#
# Default assumes an Ollama already running on the Docker host, reached via
# host.docker.internal (Ollama's default listen port is 11434). If you instead
# enable the bundled container (`--with-ollama` / `make ollama`), that step
# repoints this at http://ollama:11434/v1 for you. `--external-ollama <url>`
# overrides it to any other URL (a different LAN box, non-standard port).
#
# To use LM Studio on the host instead of Ollama, set BASE_URL to:
#   http://host.docker.internal:1234/v1
#
# To use a host-native MLX server on Apple Silicon instead, set BASE_URL to
# ${MLX_BASE_URL} (see the MLX section below and docs/mlx.md).

# Use "openai" for Ollama compatibility
HINDSIGHT_LLM_API_KEY=openai
HINDSIGHT_LLM_BASE_URL=http://host.docker.internal:11434/v1
# Must be pulled in Ollama first
HINDSIGHT_LLM_MODEL=qwen2.5:14b
HINDSIGHT_LLM_PROVIDER=openai

# Response format for structured fact extraction.
# json_schema works with Ollama >=0.3 and LM Studio; fall back to json if your
# model/version doesn't support it.
HINDSIGHT_LLM_RESPONSE_FORMAT=json_schema

# Grammar-enforce structured output via the provider's strongest schema mode,
# instead of the soft json_object fallback. Defaults to true because LM
# Studio's OpenAI-compatible server rejects json_object outright (400:
# response_format.type must be 'json_schema' or 'text'), which otherwise
# breaks fact extraction during retain. Set to false if your backend doesn't
# support grammar-enforced schemas.
HINDSIGHT_LLM_STRICT_SCHEMA=true

# HTTP timeout (seconds) for LLM calls during memory extraction.
# Large models on CPU can take minutes per request — set generously.
# Leave blank to use the image default (~360s).
HINDSIGHT_LLM_TIMEOUT=8400

# Max concurrent LLM requests. Keep at 1 for CPU inference —
# Ollama can only serve one request at a time on CPU.
HINDSIGHT_LLM_MAX_CONCURRENT=1

# Reasoning effort for models that support it (low / medium / high).
# low = fastest, least token spend. Only relevant for o-series / reasoning models.
HINDSIGHT_LLM_REASONING_EFFORT=low

# ── Per-operation LLM overrides ───────────────────────────────────────────────
# Leave blank to inherit the primary LLM settings above.
# Splitting operations across models lets you use a fast small model for
# high-volume retain (fact extraction) and a smarter model for consolidation
# and reflect (synthesis and insight generation).
#
# IMPORTANT — runaway generation warning:
#   Small models (3B) don't reliably stop generating on structured JSON tasks.
#   HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS caps output to prevent this.
#   Must be greater than HINDSIGHT_RETAIN_CHUNK_SIZE (default 3000).
#   The image default of 64000 will cause multi-hour runaway on small models.

# Retain: high-volume fact extraction — use a smaller/faster model.
HINDSIGHT_RETAIN_LLM_PROVIDER=openai
HINDSIGHT_RETAIN_LLM_API_KEY=openai
# Lightweight — must be pulled in Ollama
HINDSIGHT_RETAIN_LLM_MODEL=qwen2.5:3b

# Consolidation: memory dedup/merge — needs stronger reasoning than retain.
HINDSIGHT_CONSOLIDATION_LLM_PROVIDER=openai
HINDSIGHT_CONSOLIDATION_LLM_API_KEY=openai
HINDSIGHT_CONSOLIDATION_LLM_MODEL=qwen2.5:14b

# Reflect: higher-order synthesis — keep on the primary model.
HINDSIGHT_REFLECT_LLM_PROVIDER=openai
HINDSIGHT_REFLECT_LLM_API_KEY=openai
HINDSIGHT_REFLECT_LLM_MODEL=qwen2.5:14b

# ── Retain pipeline ───────────────────────────────────────────────────────────
# How content is decomposed into facts during a retain operation.
# concise  — compact facts, fewer LLM calls (default, good for CPU inference)
# verbose  — richer facts, more LLM calls, better recall on nuanced queries
# verbatim — store text as-is without LLM extraction (fastest, lowest quality)
# chunks   — split into fixed-size chunks, no LLM extraction
HINDSIGHT_RETAIN_EXTRACTION_MODE=concise

# Max characters per extraction chunk fed to the LLM.
# Smaller = finer-grained facts but more LLM calls.
HINDSIGHT_RETAIN_CHUNK_SIZE=3000

# Max tokens the LLM can generate per retain call.
# CRITICAL: image default is 64000 — causes runaway generation on small models.
# Must be > HINDSIGHT_RETAIN_CHUNK_SIZE. 4096 is sufficient for any real output.
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=4096

# Extract causal/relationship edges during retain (e.g. "A caused B").
# Disable to reduce LLM calls if you only need factual recall, not graph queries.
HINDSIGHT_RETAIN_EXTRACT_CAUSAL_LINKS=true

# Stable worker ID — survives container restarts so recover_own_tasks() can
# reclaim its own stuck "processing" rows automatically. Without this, every
# restart orphans whatever was mid-flight (uses container hostname by default).
HINDSIGHT_API_WORKER_ID=hindsight-worker-1

# ── Worker slot control ───────────────────────────────────────────────────────
# Controls how many concurrent tasks each worker process handles.
# With CPU inference, keep total slots low to avoid model contention.
# The math: shared_pool = MAX_SLOTS - CONSOLIDATION_SLOTS - RETAIN_SLOTS
# At 3/1/1: 1 consolidation + 1 retain + 1 shared = 3 max per worker.
HINDSIGHT_API_WORKER_MAX_SLOTS=3
HINDSIGHT_API_WORKER_CONSOLIDATION_MAX_SLOTS=1
HINDSIGHT_API_WORKER_RETAIN_MAX_SLOTS=1
HINDSIGHT_API_WORKER_POLL_INTERVAL_MS=1000

# ── Embeddings ────────────────────────────────────────────────────────────────
# Provider for vector embeddings used in semantic search.
# local  = bundled HuggingFace model, no external calls (default)
# openai = OpenAI text-embedding-3-* (requires OPENAI_API_KEY)
HINDSIGHT_EMBEDDINGS_PROVIDER=local

# Model used when EMBEDDINGS_PROVIDER=local.
# bge-small-en-v1.5 — fast, 33M params, English-only (default)
# BAAI/bge-m3       — larger, multilingual, better recall quality
HINDSIGHT_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5

# ── Reranker ──────────────────────────────────────────────────────────────────
# Reranking re-scores top-N recall candidates with a cross-encoder for
# much better precision than vector similarity alone.
# local  = bundled cross-encoder model (default, no external calls)
# cohere = Cohere Rerank API
HINDSIGHT_RERANKER_PROVIDER=local

# Cross-encoder model used when RERANKER_PROVIDER=local.
# ms-marco-MiniLM-L-6-v2  — fast, good quality (default)
# ms-marco-MiniLM-L-12-v2 — slower but better quality
HINDSIGHT_RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Concurrency cap for the local reranker (cross-encoder is CPU-bound).
HINDSIGHT_RERANKER_MAX_CONCURRENT=4

# Candidates to fetch before reranking. Higher = better coverage, more compute.
HINDSIGHT_RERANKER_MAX_CANDIDATES=300

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Cosine similarity threshold. Hits below this score are discarded before
# reranking. Lower = broader (noisier); 0.5+ = stricter.
HINDSIGHT_SEMANTIC_MIN_SIMILARITY=0.3

# Max concurrent recall (retrieval) requests.
HINDSIGHT_RECALL_MAX_CONCURRENT=32


# =============================================================================
# MONITORING (PROMETHEUS + GRAFANA + ALERTMANAGER + LOKI/PROMTAIL)
# =============================================================================

# Windows: C:/Users/YourName/HermesFlow/monitoring
# Houses Prometheus TSDB, Grafana state, Alertmanager state, and Loki chunks.
MONITORING_DATA_DIR=${HOME}/HermesFlow/monitoring

# How long Prometheus keeps raw metrics on disk.
PROMETHEUS_RETENTION=15d

# Grafana admin credentials — change before exposing to a network.
GRAFANA_ADMIN_USER=admin
# <REQUIRED> Generate: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=

# Image version pins — leave blank or "latest" to always pull newest.
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
CADVISOR_VERSION=latest
NODE_EXPORTER_VERSION=latest
PG_EXPORTER_VERSION=latest
ALERTMANAGER_VERSION=latest
LOKI_VERSION=latest
PROMTAIL_VERSION=latest

# How long Loki retains logs before deleting them, in Go duration format
# (e.g. 720h = 30 days). Prevents the log volume from filling the disk.
LOKI_RETENTION_PERIOD=720h


# =============================================================================
# OLLAMA (LOCAL LLM INFERENCE)
# =============================================================================
# Optional. Enable with `--with-ollama` (installers) or `make ollama`, which
# layers docker-compose.ollama.yml by adding it to COMPOSE_FILE below. These
# vars only take effect when that override is loaded. Already running Ollama
# elsewhere (the Docker host, another box on your LAN)? Skip this override and
# use `--external-ollama <url>` instead — it points HINDSIGHT_LLM_BASE_URL /
# BASEROW_OLLAMA_HOST at it without starting a bundled container.
#
# To enable manually, set:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.ollama.yml

# Pin to a tagged release for production, e.g. OLLAMA_VERSION=0.3.12
OLLAMA_VERSION=latest

# Storage path for downloaded model weights (can be several GB per model).
# Windows: C:/Users/YourName/HermesFlow/ollama
OLLAMA_DATA_DIR=${HOME}/HermesFlow/ollama

# Host bind and port for direct access outside of Caddy.
# 127.0.0.1 = localhost only. 0.0.0.0 = LAN-visible.
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434

# How long to keep a loaded model in memory after the last request.
# -1  = keep forever (zero reload latency, recommended for always-on nodes)
# 30m = reclaim RAM after 30 min idle (adds ~60-80s reload cost on next request)
OLLAMA_KEEP_ALIVE=-1

# CPU threads for llama.cpp matrix ops.
# Set to physical P-core count — AVX_VNNI runs on P-cores; E-cores add latency.
# Intel Core Ultra 5 125H : 4 P-cores x 2 HT = 8
# Apple M-series           : use total performance core count (e.g. M3 Pro = 12)
# AMD Ryzen                : use physical core count
OLLAMA_NUM_THREAD=8

# Context window (tokens). Larger = more memory per request.
# 32768 = full capacity for qwen2.5 models with sufficient RAM.
# 16384 = safer default for 16 GB RAM or if first-token latency is too slow.
# 8192  = fit more models simultaneously on constrained hardware.
OLLAMA_CONTEXT_LENGTH=32768

# Max concurrent inference requests.
# Keep at 1 for CPU — parallelism only helps with GPU VRAM batching.
OLLAMA_NUM_PARALLEL=1

# Models to keep loaded simultaneously. Each holds its full weight in RAM.
# 2 = qwen2.5:14b (~12 GB) + qwen2.5:3b (~3 GB) = ~15 GB combined.
# Requires enough free RAM for all loaded models + KV cache + compute buffers.
OLLAMA_MAX_LOADED_MODELS=2

# How long to wait for a model load before declaring a stall.
# Increase for large models on slow or network-attached storage.
OLLAMA_LOAD_TIMEOUT=15m

# ── Resource caps ─────────────────────────────────────────────────────────────
# 32G covers 14B Q4_K_M (~12 GB) + 3B (~3 GB) + KV cache + headroom.
# Increase to 48G to fit 70B IQ2_XS (~25 GB), though 1-3 t/s may not justify it.
OLLAMA_MEM_LIMIT=32G
# 8 CPU units = P-core threads; leaves E-cores + LPE for the rest of the stack.
OLLAMA_CPU_LIMIT=8.0

# ── GPU settings ──────────────────────────────────────────────────────────────
# CPU-only defaults. For GPU inference:
#   NVIDIA CUDA : set CUDA_VISIBLE_DEVICES=0 and uncomment gpu reservations in compose
#   AMD ROCm    : set ROCR_VISIBLE_DEVICES=0 or HIP_VISIBLE_DEVICES=0
#   Vulkan/GGML : set GGML_VK_VISIBLE_DEVICES=0 and OLLAMA_VULKAN=true
#   Intel iGPU  : OLLAMA_INTEL_GPU=1 — only practical for models < 3B (limited VRAM)
#
# NOTE: iGPU on Intel Core Ultra shares system RAM — no dedicated VRAM bandwidth
# advantage. CPU inference is typically faster for models > 3B on integrated graphics.
OLLAMA_INTEL_GPU=0
OLLAMA_VULKAN=false
CUDA_VISIBLE_DEVICES=
GGML_VK_VISIBLE_DEVICES=
HIP_VISIBLE_DEVICES=
GPU_DEVICE_ORDINAL=
ROCR_VISIBLE_DEVICES=

# Number of model layers to offload to GPU. 0 = CPU-only (safe default).
# Set to a positive integer (or blank for auto-detect) when you have a GPU.
# Pair with the matching device-visibility var above and the compose reservations block.
OLLAMA_NUM_GPU=0

# Hard cap on VRAM usage in bytes. Prevents Ollama from consuming all GPU memory.
# Leave blank for no cap. Examples: 4294967296 = 4 GB, 6442450944 = 6 GB.
OLLAMA_MAX_VRAM=

# ── Inference quality ─────────────────────────────────────────────────────────
# Flash attention: reduces memory bandwidth on long contexts. Safe to enable on
# all architectures including hybrid models (e.g. lfm2, mamba).
OLLAMA_FLASH_ATTENTION=true

# KV-cache quantisation. q8_0 halves KV-cache RAM vs f16 with minimal quality loss.
# Options:
#   q8_0 — recommended for CPU inference (half RAM, negligible quality loss)
#   f16  — full precision (higher quality, more RAM)
#   q4_0 — aggressive compression (fastest, lower quality)
OLLAMA_KV_CACHE_TYPE=q8_0

# ── Housekeeping ──────────────────────────────────────────────────────────────
# Set true to disable saving prompt history to disk.
OLLAMA_NOHISTORY=false

# Set true to prevent Ollama from cleaning up unused model blobs.
# Leave false unless you are manually managing the model store.
OLLAMA_NOPRUNE=false

# =============================================================================
# MLX (APPLE SILICON LOCAL INFERENCE — OPTIONAL ALTERNATIVE TO OLLAMA)
# =============================================================================
# MLX runs natively on the macOS host's GPU/Neural Engine — Docker Desktop on
# Mac cannot pass Metal through to containers, so this is NOT a docker-compose
# service. Install mlx-lm and run `mlx_lm.server` on the host instead — see
# docs/mlx.md for setup.
#
# Once the host server is running, point the stack at it:
#   - Hindsight: set HINDSIGHT_LLM_BASE_URL=${MLX_BASE_URL} (and
#     HINDSIGHT_RETAIN/CONSOLIDATION/REFLECT_LLM_* if you want per-operation
#     overrides) instead of the Ollama default.
#   - Hermes:    run `make mlx` to route the agent's own model calls there.
# Embeddings/reranking are unaffected — Hindsight runs those locally regardless.

# Port mlx_lm.server listens on (host side).
MLX_HOST_PORT=8080

# URL the containers use to reach it — host.docker.internal resolves to the
# Mac host from inside any container that has the extra_hosts entry (hermes,
# hindsight already do).
MLX_BASE_URL=http://host.docker.internal:8080/v1

# Model to load. Must fit in unified memory — 4-bit quantised 7-8B models are
# the sweet spot for an 8-16GB M1. See docs/mlx.md for more sizing guidance.
MLX_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit

# =============================================================================
#  Headroom — context optimisation proxy
# =============================================================================

# Daily USD budget cap for the Headroom proxy (leave blank = unlimited).
HEADROOM_DAILY_BUDGET=
# Container resource limits. Bump HEADROOM_MEM_LIMIT to 1G-2G if enabling
# LLMLingua ML compression (uncomment HEADROOM_LLMLINGUA in docker-compose.yml).
HEADROOM_MEM_LIMIT=512M
HEADROOM_CPU_LIMIT=0.5
HEADROOM_TELEMETRY=false

# =============================================================================
# COLLECTION DATABASE (shared data-collection store — always present)
# =============================================================================
# One Postgres instance, three isolated schemas:
#   - `baserow`    Baserow's own private app schema (Baserow only).
#   - `directus`   Directus's own system tables (Directus only).
#   - `collection` shared business data (page scrapes, LLM generations, triage
#                  records) — writable by Directus and Windmill, NOT Baserow.
# See collection_db/initdb/01-init.sh for the role/grant setup. Reachable
# directly from the host (COLLECTION_DB_BIND) for ad-hoc psql/DBeaver access;
# Hermes has no network route to it — agent access is via Directus/Baserow MCP.

# Windows: C:/Users/YourName/HermesFlow/collection
COLLECTION_DB_DATA_DIR=${HOME}/HermesFlow/collection/db
COLLECTION_DB_NAME=collection

# Host bind + port for direct access (psql/DBeaver/etc).
COLLECTION_DB_BIND=127.0.0.1
COLLECTION_DB_PORT=5433

COLLECTION_DB_MEM_LIMIT=1G
COLLECTION_DB_CPU_LIMIT=1.0

# ── Credentials (generated by `make secrets` / the installers) ───────────────
# Bootstrap superuser for the collection_db instance.
COLLECTION_DB_ADMIN_USER=collection_admin
# <REQUIRED> Generate: openssl rand -hex 16
COLLECTION_DB_ADMIN_PASSWORD=

# Role password for Windmill's connection into the `collection` schema (used
# by a Windmill DB resource you configure once the service is up — not a
# compose-level setting).
# <REQUIRED> Generate: openssl rand -hex 16
WINDMILL_COLLECTION_DB_PASSWORD=

# Role password for the data_platform dlt/dbt pipeline's connection into the
# `data_platform` schema (used by the f/data_platform/data_platform_db
# Windmill resource — see docs/plans/datalake.md).
# <REQUIRED> Generate: openssl rand -hex 16
DATA_PLATFORM_DB_PASSWORD=

# =============================================================================
# BASEROW (STRUCTURED-DATA STORE — no-code DB UI + REST API + MCP)
# =============================================================================
# Optional. Enable with `--with-baserow` (installers) or `make baserow`, which
# layer docker-compose.baserow.yml by adding it to COMPOSE_FILE below. The
# all-in-one baserow image is pointed at the base stack's shared collection_db
# (its own private `baserow` schema — see COLLECTION DATABASE above) plus a
# dedicated baserow_redis container (its embedded Postgres/Redis are
# auto-disabled). Attachments are stored on the BASEROW_DATA_DIR volume (no
# MinIO needed).
#
# To enable manually, set:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.baserow.yml

# Pin the image (https://hub.docker.com/r/baserow/baserow/tags).
BASEROW_VERSION=2.2.2

# ── Infrastructure ────────────────────────────────────────────────────────────
# Windows: C:/Users/YourName/HermesFlow/baserow
BASEROW_DATA_DIR=${HOME}/HermesFlow/baserow
BASEROW_REDIS_DATA_DIR=${HOME}/HermesFlow/baserow/redis

# Public URL Baserow generates links against — must match how you reach it and
# start with http:// or https://. Default assumes access via the stack's Caddy.
BASEROW_PUBLIC_URL=http://baserow.localhost

# Host bind + port for direct access outside of Caddy (primary access is Caddy).
BASEROW_BIND=127.0.0.1
BASEROW_PORT=3010

# Resource limits for the all-in-one container (runs backend + workers).
BASEROW_MEM_LIMIT=2G
BASEROW_CPU_LIMIT=2.0

# ── Credentials (generated by `make secrets` / the installers) ───────────────
# Django signing key.
# <REQUIRED> Generate: openssl rand -hex 32
BASEROW_SECRET_KEY=

# Role into collection_db's private `baserow` schema (see COLLECTION DATABASE
# above) — NOT a separate database/container anymore.
BASEROW_DB_USER=baserow
# <REQUIRED> Generate: openssl rand -hex 16
BASEROW_DB_PASSWORD=

# Password for the dedicated baserow_redis container.
# <REQUIRED> Generate: openssl rand -hex 16
BASEROW_REDIS_PASSWORD=

# ── Generative AI ────────────────────────────────────────────────────────────
# Default assumes an Ollama already running on the Docker host, reached via
# host.docker.internal. Enabling the bundled container (`--with-ollama` /
# `make ollama`) repoints this at http://ollama:11434 for you. Either way,
# pull a model first (e.g. `docker exec ollama ollama pull llama3.2` for the
# bundled container, or run it on the host directly), then list it in
# BASEROW_OLLAMA_MODELS. Note: Baserow's OpenAI provider has no base-URL
# override, so the Hermes gateway can't be used as an OpenAI-compatible target.
# For cloud models, fill in a provider key + its models list below.
BASEROW_OLLAMA_HOST=http://host.docker.internal:11434
BASEROW_OLLAMA_MODELS=
BASEROW_OPENAI_API_KEY=
BASEROW_OPENAI_MODELS=
BASEROW_ANTHROPIC_API_KEY=
BASEROW_ANTHROPIC_MODELS=
BASEROW_OPENROUTER_API_KEY=
BASEROW_OPENROUTER_MODELS=
BASEROW_MISTRAL_API_KEY=
BASEROW_MISTRAL_MODELS=

# ── MCP (expose Baserow tables to Hermes as tools) ───────────────────────────
# `make baserow-mcp` creates an MCP endpoint in your Baserow workspace and wires
# it into Hermes (via the baked-in mcp-remote bridge). It logs in with the
# credentials below — CREATING the account if it doesn't exist yet. Leave EMAIL
# and PASSWORD blank to have them GENERATED and SAVED back here on first run
# (use those to log into the UI). Set your own to use an existing account.
# See docs/baserow-accounts-and-sharing.md for account + data-sharing options.
BASEROW_EMAIL=
BASEROW_PASSWORD=
# Workspace the agent uses — a NUMERIC id, filled in automatically on first run.
# If set and the workspace still exists, it's reused; otherwise a new one is
# created and this is rewritten. (BASEROW_MCP_WORKSPACE only names a new one.)
BASEROW_WORKSPACE_ID=
BASEROW_MCP_WORKSPACE=Hermes

# =============================================================================
# DIRECTUS (TRIAGE UI — record review, AI field generation, REST/GraphQL API, MCP)
# =============================================================================
# Optional. Enable with `--with-directus` (installers) or `make directus`, which
# layers docker-compose.directus.yml by adding it to COMPOSE_FILE below. Uses
# the base stack's shared collection_db: DB_SCHEMA=directus isolates Directus's
# own system tables, while it's also granted full rights on the shared
# `collection` schema as its application data. See COLLECTION DATABASE above.
#
# To enable manually, set:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.directus.yml

# Pin the image (https://hub.docker.com/r/directus/directus/tags).
DIRECTUS_VERSION=latest

# ── Infrastructure ────────────────────────────────────────────────────────────
# Windows: C:/Users/YourName/HermesFlow/directus
DIRECTUS_UPLOADS_DIR=${HOME}/HermesFlow/directus/uploads
DIRECTUS_EXTENSIONS_DIR=${HOME}/HermesFlow/directus/extensions

# Public URL Directus generates links against. Default assumes access via the
# stack's Caddy.
DIRECTUS_PUBLIC_URL=http://directus.localhost

# Host bind + port for direct access outside of Caddy (primary access is Caddy).
DIRECTUS_BIND=127.0.0.1
DIRECTUS_PORT=8055

DIRECTUS_MEM_LIMIT=1G
DIRECTUS_CPU_LIMIT=1.0

# ── Credentials (generated by `make secrets` / the installers) ───────────────
# Project key + JWT-signing secret.
# <REQUIRED> Generate: openssl rand -hex 16
DIRECTUS_KEY=
# <REQUIRED> Generate: openssl rand -hex 32
DIRECTUS_SECRET=

# First-run admin account.
DIRECTUS_ADMIN_EMAIL=admin@directus.local
# <REQUIRED> Generate: openssl rand -hex 16
DIRECTUS_ADMIN_PASSWORD=

# Role into collection_db's `directus` schema (see COLLECTION DATABASE above).
DIRECTUS_DB_USER=directus
# <REQUIRED> Generate: openssl rand -hex 16
DIRECTUS_DB_PASSWORD=

# ── MCP (expose Directus collections to Hermes as tools) ────────────────────
# MCP is native since Directus v11.12+ but is a Studio-only setting, not a
# compose/env var: after `make directus`, log into the UI (DIRECTUS_ADMIN_EMAIL
# / DIRECTUS_ADMIN_PASSWORD), enable MCP under Settings -> AI, generate an
# access token for a dedicated MCP user, then register that endpoint with
# Hermes yourself (`docker exec hermes hermes mcp add directus ...`) — there is
# no `make directus-mcp` equivalent to `make baserow-mcp` since Directus has no
# documented API to script this provisioning step.
