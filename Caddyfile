# =============================================================================
#  Caddyfile — single ingress for the stack
#
#  LAN/homelab default: plain HTTP on hostnames ending in .localhost
#  (these resolve to 127.0.0.1 automatically on most systems; otherwise add
#   them to /etc/hosts pointing at the docker host).
#
#  To go to a real domain with automatic Let's Encrypt TLS:
#    1. uncomment the email line in the global block
#    2. replace each `http://<name>.localhost` with `<name>.yourdomain.com`
#       (drop the `http://` prefix — Caddy then provisions HTTPS for you)
#    3. make sure ports 80 and 443 are reachable from the internet
# =============================================================================

{
    admin off
    # email you@example.com
}

# --- Windmill ---------------------------------------------------------------
# LSP websocket traffic must go to the lsp container; everything else to server.
http://windmill.localhost {
    reverse_proxy /ws/* windmill_lsp:3001
    reverse_proxy /*    windmill_server:8000
}

# --- Hermes dashboard (built into the gateway container, port 9119) ---------
http://hermes.localhost {
    reverse_proxy hermes:9119
}

# --- Hermes API (no built-in auth — consider basicauth here) ----------------
http://hermes-api.localhost {
    reverse_proxy hermes:8642
}

# --- Hindsight (no built-in auth — consider basicauth here) ----------------
http://hindsight.localhost {
    reverse_proxy hindsight:9999
}

# --- Grafana (monitoring dashboards) ----------------------------------------
http://grafana.localhost {
    reverse_proxy grafana:3000
}

# --- Prometheus (raw metrics — restrict to trusted networks in production) --
http://prometheus.localhost {
    reverse_proxy prometheus:9090
}

# --- Ollama (local LLM inference — restrict to trusted networks in production)
# Only resolves when the docker-compose.ollama.yml override is active
# (COMPOSE_FILE / `make ollama`); otherwise this route 502s until Ollama is up.
http://ollama.localhost {
    reverse_proxy ollama:11434
}

# --- Headroom (context compression stats / dashboard) -----------------------
http://headroom.localhost {
    reverse_proxy headroom:8787
}

# --- Alertmanager (alert UI / silencing — no built-in auth) -----------------
http://alertmanager.localhost {
    reverse_proxy alertmanager:9093
}

# --- Baserow (structured-data UI + REST API + MCP; has built-in auth) --------
# Only resolves when the docker-compose.baserow.yml override is active
# (COMPOSE_FILE / `make baserow`); otherwise this route 502s until Baserow is up.
http://baserow.localhost {
    reverse_proxy baserow:80
}

# --- Joshu (ArozOS desktop at the root; Joshu API under /joshu/*) ------------
# Only resolves when the docker-compose.joshu.yml override is active
# (COMPOSE_FILE / `make joshu`); otherwise this route 502s until Joshu is up.
http://joshu.localhost {
    reverse_proxy /joshu/* joshu-stack:8788
    reverse_proxy joshu-stack:8787
}

# --- Joshu's BUNDLED Hermes admin dashboard -----------------------------------
# Not the stack's Hermes (that's hermes.localhost) — Joshu runs its own pinned,
# patched gateway inside joshu-stack; see docs/joshu.md. The bundled dashboard
# rejects non-loopback Host headers, hence the header_up rewrite.
http://joshu-admin.localhost {
    reverse_proxy joshu-stack:9119 {
        header_up Host 127.0.0.1:9119
    }
}