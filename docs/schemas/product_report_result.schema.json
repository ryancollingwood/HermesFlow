{
  "$defs": {
    "ArtifactRef": {
      "description": "Points at one stored artifact and how it fits into a run's lineage.",
      "properties": {
        "artifact_id": {
          "description": "Unique ID for this artifact reference.",
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "content_hash": {
          "description": "Lowercase 64-character hex SHA-256 digest of the artifact's content.",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "description": "When this artifact was written (UTC).",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "creator_capability": {
          "description": "Capability path that produced this artifact.",
          "minLength": 1,
          "title": "Creator Capability",
          "type": "string"
        },
        "creator_capability_version": {
          "description": "Version of that capability at the time it produced this artifact.",
          "minLength": 1,
          "title": "Creator Capability Version",
          "type": "string"
        },
        "derived_from": {
          "description": "artifact_id of each artifact this one was derived from. Empty for a raw artifact with no upstream input captured by this store.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "media_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IANA media type of the stored content. HF-017 adapters always populate it; optional for backward compatibility with pre-HF-017 references.",
          "title": "Media Type"
        },
        "schema_version": {
          "default": "1.0",
          "description": "Schema MAJOR.MINOR this record was written against.",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Artifact content size in bytes. HF-017 storage adapters always populate it; optional for backward compatibility with pre-HF-017 references.",
          "title": "Size Bytes"
        },
        "stage": {
          "$ref": "#/$defs/ArtifactStage",
          "description": "raw (untransformed input), intermediate (a transformation step's output), or final (a run's end result)."
        },
        "storage_uri": {
          "description": "Where the content lives, e.g. file:///shared/artifacts/<hash[:2]>/<hash>.",
          "minLength": 1,
          "title": "Storage Uri",
          "type": "string"
        },
        "trace_id": {
          "description": "trace_id of the ExecutionContext that produced this artifact.",
          "format": "uuid",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "stage",
        "content_hash",
        "storage_uri",
        "creator_capability",
        "creator_capability_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactStage": {
      "description": "Where an artifact sits in a run's raw -> intermediate -> final pipeline.",
      "enum": [
        "raw",
        "intermediate",
        "final"
      ],
      "title": "ArtifactStage",
      "type": "string"
    },
    "ArtifactSummary": {
      "description": "A lightweight, presentation-facing pointer to one produced artifact.\n\nReferences an ArtifactRef by id rather than duplicating its full record\n(see f.libraries.lineage.models.ArtifactRef) \u2014 this is what a result\nenvelope shows a user, not the authoritative artifact store entry.",
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short, human-facing description of what this artifact is.",
          "title": "Description"
        },
        "stage": {
          "$ref": "#/$defs/ArtifactStage"
        },
        "storage_uri": {
          "minLength": 1,
          "title": "Storage Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "stage",
        "storage_uri"
      ],
      "title": "ArtifactSummary",
      "type": "object"
    },
    "CapabilityChange": {
      "description": "One capability-lifecycle change (architecture/adr/0002) this task caused.",
      "properties": {
        "from_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Version"
        },
        "kind": {
          "$ref": "#/$defs/CapabilityChangeKind"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "to_version": {
          "minLength": 1,
          "title": "To Version",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "to_version"
      ],
      "title": "CapabilityChange",
      "type": "object"
    },
    "CapabilityChangeKind": {
      "enum": [
        "created_candidate",
        "modified_candidate",
        "promoted"
      ],
      "title": "CapabilityChangeKind",
      "type": "string"
    },
    "ComparisonSummary": {
      "additionalProperties": false,
      "properties": {
        "comparable_price_count": {
          "minimum": 0,
          "title": "Comparable Price Count",
          "type": "integer"
        },
        "covered_source_count": {
          "minimum": 0,
          "title": "Covered Source Count",
          "type": "integer"
        },
        "duplicate_product_count": {
          "minimum": 0,
          "title": "Duplicate Product Count",
          "type": "integer"
        },
        "empty_source_count": {
          "minimum": 0,
          "title": "Empty Source Count",
          "type": "integer"
        },
        "priced_product_count": {
          "minimum": 0,
          "title": "Priced Product Count",
          "type": "integer"
        },
        "requested_source_count": {
          "minimum": 0,
          "title": "Requested Source Count",
          "type": "integer"
        },
        "snapshot_count": {
          "minimum": 0,
          "title": "Snapshot Count",
          "type": "integer"
        },
        "unique_product_count": {
          "minimum": 0,
          "title": "Unique Product Count",
          "type": "integer"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        }
      },
      "required": [
        "requested_source_count",
        "covered_source_count",
        "empty_source_count",
        "snapshot_count",
        "unique_product_count",
        "duplicate_product_count",
        "priced_product_count",
        "comparable_price_count",
        "warning_count"
      ],
      "title": "ComparisonSummary",
      "type": "object"
    },
    "ComparisonWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "execution_trace_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Trace Id"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "normalized_product_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Product Id"
        },
        "source_artifact_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Artifact Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ComparisonWarning",
      "type": "object"
    },
    "ExecutionContext": {
      "description": "Identifies one workflow/capability execution and who/what initiated it.",
      "properties": {
        "capability": {
          "description": "Capability path that is executing, e.g. f/capabilities/collection/web_fetch.",
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "capability_version": {
          "description": "Version of that capability that is executing.",
          "minLength": 1,
          "title": "Capability Version",
          "type": "string"
        },
        "conversation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hermes conversation/session this execution was requested from, if any.",
          "title": "Conversation Id"
        },
        "initiating_actor": {
          "description": "Who/what initiated this execution: a user id, 'hermes', a schedule name, etc.",
          "minLength": 1,
          "title": "Initiating Actor",
          "type": "string"
        },
        "parent_trace_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "trace_id of the execution that spawned this one, if any (e.g. a flow step's sub-run). Absent for a top-level execution.",
          "title": "Parent Trace Id"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caller-supplied idempotency/correlation key for this specific request, if any.",
          "title": "Request Id"
        },
        "schema_version": {
          "default": "1.0",
          "description": "Schema MAJOR.MINOR this record was written against.",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "description": "When this execution began (UTC).",
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "trace_id": {
          "description": "Unique ID for this execution.",
          "format": "uuid",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "capability_version",
        "initiating_actor"
      ],
      "title": "ExecutionContext",
      "type": "object"
    },
    "ExecutionResult": {
      "description": "The standard envelope Hermes uses to present one task's outcome.",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactSummary"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "capability_changes": {
          "items": {
            "$ref": "#/$defs/CapabilityChange"
          },
          "title": "Capability Changes",
          "type": "array"
        },
        "capability_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version of workflow_path that ran, if known.",
          "title": "Capability Version"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "execution_type": {
          "$ref": "#/$defs/ExecutionType"
        },
        "failure_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actionable explanation of what went wrong and, where possible, what to do about it. Required when outcome is failure.",
          "title": "Failure Summary"
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindmillJobRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Windmill job that proves this ran. Required whenever outcome is success or partial for a windmill_job result. May be absent for a failure that occurred before a job could be submitted (e.g. Windmill unreachable) or for a conversational result, where it must always be absent."
        },
        "outcome": {
          "$ref": "#/$defs/ResultOutcome"
        },
        "schema_version": {
          "default": "1.0",
          "description": "Schema MAJOR.MINOR this record was written against.",
          "title": "Schema Version",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "workflow_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Windmill script/flow path that ran. Required when execution_type is windmill_job; always None for conversational results.",
          "title": "Workflow Path"
        }
      },
      "required": [
        "outcome",
        "execution_type"
      ],
      "title": "ExecutionResult",
      "type": "object"
    },
    "ExecutionType": {
      "description": "What kind of work this result describes.\n\n`windmill_job` \u2014 task code ran through Windmill (architecture/adr/0001's\nexclusive execution boundary); `conversational` \u2014 Hermes answered,\nexplained, or drafted text without executing anything (ADR 0001's\nexplicit exception).",
      "enum": [
        "windmill_job",
        "conversational"
      ],
      "title": "ExecutionType",
      "type": "string"
    },
    "LineageState": {
      "description": "Serializable, content-free state passed between Windmill flow steps.",
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "contexts": {
          "additionalProperties": {
            "$ref": "#/$defs/ExecutionContext"
          },
          "propertyNames": {
            "format": "uuid"
          },
          "title": "Contexts",
          "type": "object"
        },
        "root_trace_id": {
          "format": "uuid",
          "title": "Root Trace Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "root_trace_id"
      ],
      "title": "LineageState",
      "type": "object"
    },
    "PriceDifference": {
      "additionalProperties": false,
      "properties": {
        "absolute_difference": {
          "title": "Absolute Difference",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "maximum": {
          "title": "Maximum",
          "type": "string"
        },
        "minimum": {
          "title": "Minimum",
          "type": "string"
        },
        "percentage_difference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percentage Difference"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/SourcePrice"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "currency",
        "values",
        "minimum",
        "maximum",
        "absolute_difference"
      ],
      "title": "PriceDifference",
      "type": "object"
    },
    "ProductComparisonGroup": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "match_key": {
          "title": "Match Key",
          "type": "string"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ProductObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "price_differences": {
          "items": {
            "$ref": "#/$defs/PriceDifference"
          },
          "title": "Price Differences",
          "type": "array"
        }
      },
      "required": [
        "match_key",
        "display_name",
        "observations"
      ],
      "title": "ProductComparisonGroup",
      "type": "object"
    },
    "ProductComparisonResult": {
      "additionalProperties": false,
      "properties": {
        "comparison_version": {
          "default": "1.0.0",
          "title": "Comparison Version",
          "type": "string"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/ProductComparisonGroup"
          },
          "title": "Products",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceCoverage"
          },
          "title": "Sources",
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/ComparisonSummary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ComparisonWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "sources",
        "products"
      ],
      "title": "ProductComparisonResult",
      "type": "object"
    },
    "ProductObservation": {
      "additionalProperties": false,
      "properties": {
        "brand": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "canonical_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Url"
        },
        "execution_trace_id": {
          "format": "uuid",
          "title": "Execution Trace Id",
          "type": "string"
        },
        "gtin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gtin"
        },
        "mpn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mpn"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "normalized_product_id": {
          "title": "Normalized Product Id",
          "type": "string"
        },
        "prices": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prices",
          "type": "object"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        },
        "snapshot_id": {
          "title": "Snapshot Id",
          "type": "integer"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        },
        "source_product_id": {
          "title": "Source Product Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "execution_trace_id",
        "source_artifact_id",
        "normalized_product_id",
        "source_product_id",
        "name"
      ],
      "title": "ProductObservation",
      "type": "object"
    },
    "ResultOutcome": {
      "description": "How a task ended.",
      "enum": [
        "success",
        "partial",
        "failure"
      ],
      "title": "ResultOutcome",
      "type": "string"
    },
    "SourceCoverage": {
      "additionalProperties": false,
      "properties": {
        "duplicate_product_count": {
          "minimum": 0,
          "title": "Duplicate Product Count",
          "type": "integer"
        },
        "execution_trace_id": {
          "format": "uuid",
          "title": "Execution Trace Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "priced_product_count": {
          "minimum": 0,
          "title": "Priced Product Count",
          "type": "integer"
        },
        "product_count": {
          "minimum": 0,
          "title": "Product Count",
          "type": "integer"
        },
        "source_artifact_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Artifact Id"
        },
        "source_content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Content Hash"
        },
        "source_trace_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Trace Id"
        },
        "unique_product_count": {
          "minimum": 0,
          "title": "Unique Product Count",
          "type": "integer"
        }
      },
      "required": [
        "execution_trace_id",
        "product_count",
        "unique_product_count",
        "priced_product_count",
        "duplicate_product_count"
      ],
      "title": "SourceCoverage",
      "type": "object"
    },
    "SourcePrice": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "string"
        },
        "normalized_product_id": {
          "title": "Normalized Product Id",
          "type": "string"
        },
        "source_artifact_id": {
          "format": "uuid",
          "title": "Source Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "source_artifact_id",
        "normalized_product_id",
        "amount"
      ],
      "title": "SourcePrice",
      "type": "object"
    },
    "WindmillJobRef": {
      "description": "Points at the Windmill job that proves a windmill_job result actually ran.",
      "properties": {
        "job_id": {
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "path": {
          "description": "Script or flow path that ran.",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "workspace": {
          "default": "main",
          "minLength": 1,
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "path"
      ],
      "title": "WindmillJobRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "comparison": {
      "$ref": "#/$defs/ProductComparisonResult"
    },
    "dataset_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "execution_result": {
      "$ref": "#/$defs/ExecutionResult"
    },
    "lineage": {
      "$ref": "#/$defs/LineageState"
    },
    "report_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "report_text": {
      "title": "Report Text",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
