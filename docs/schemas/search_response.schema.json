{
  "$defs": {
    "AutonomyLevel": {
      "description": "Whether an action may run unattended or needs a human approval step.",
      "enum": [
        "automatic",
        "approval_required"
      ],
      "title": "AutonomyLevel",
      "type": "string"
    },
    "AutonomyPolicy": {
      "description": "Per-action autonomy for one capability. See ALWAYS_APPROVAL_REQUIRED.",
      "properties": {
        "compose": {
          "$ref": "#/$defs/AutonomyLevel",
          "default": "automatic"
        },
        "create_candidate": {
          "$ref": "#/$defs/AutonomyLevel",
          "default": "automatic"
        },
        "discover": {
          "$ref": "#/$defs/AutonomyLevel",
          "default": "automatic"
        },
        "execute": {
          "$ref": "#/$defs/AutonomyLevel",
          "default": "automatic"
        },
        "modify_candidate": {
          "$ref": "#/$defs/AutonomyLevel",
          "default": "automatic"
        },
        "promote": {
          "$ref": "#/$defs/AutonomyLevel",
          "default": "approval_required"
        },
        "schedule": {
          "$ref": "#/$defs/AutonomyLevel",
          "default": "approval_required"
        }
      },
      "title": "AutonomyPolicy",
      "type": "object"
    },
    "CapabilityEffects": {
      "description": "Side-effect categories this capability may cause when it runs.",
      "properties": {
        "database": {
          "default": false,
          "title": "Database",
          "type": "boolean"
        },
        "external": {
          "default": false,
          "description": "Any other externally-visible side effect not covered above (sending a notification, calling a third-party API that isn't a plain network fetch, etc.).",
          "title": "External",
          "type": "boolean"
        },
        "filesystem": {
          "default": false,
          "title": "Filesystem",
          "type": "boolean"
        },
        "network": {
          "default": false,
          "title": "Network",
          "type": "boolean"
        }
      },
      "title": "CapabilityEffects",
      "type": "object"
    },
    "CapabilityKind": {
      "enum": [
        "script",
        "flow"
      ],
      "title": "CapabilityKind",
      "type": "string"
    },
    "CapabilityLimits": {
      "description": "Bounds enforced when this capability runs. All optional \u2014 unset means unbounded.",
      "properties": {
        "max_concurrency": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Concurrency"
        },
        "rate_limit_per_minute": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Limit Per Minute"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        }
      },
      "title": "CapabilityLimits",
      "type": "object"
    },
    "CapabilityMaturity": {
      "description": "How much this capability has proven itself in production.",
      "enum": [
        "experimental",
        "stable",
        "deprecated"
      ],
      "title": "CapabilityMaturity",
      "type": "string"
    },
    "CapabilityMetadata": {
      "description": "Agent-selection metadata for one discoverable capability.",
      "properties": {
        "autonomy": {
          "$ref": "#/$defs/AutonomyPolicy"
        },
        "capability_version": {
          "minLength": 1,
          "title": "Capability Version",
          "type": "string"
        },
        "dependencies": {
          "description": "Other capability paths this one depends on (HF-012 impact analysis traverses these).",
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "deterministic": {
          "default": true,
          "description": "Whether identical inputs are expected to produce identical outputs. AI/model-backed capabilities must set this false.",
          "title": "Deterministic",
          "type": "boolean"
        },
        "effects": {
          "$ref": "#/$defs/CapabilityEffects"
        },
        "limits": {
          "$ref": "#/$defs/CapabilityLimits"
        },
        "maturity": {
          "$ref": "#/$defs/CapabilityMaturity"
        },
        "owners": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Owners",
          "type": "array"
        },
        "path": {
          "description": "Windmill path this metadata describes, e.g. f/capabilities/collection/web_fetch. Windmill remains authoritative for the script's own argument schema \u2014 this only points at it.",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "scheduled_health": {
          "$ref": "#/$defs/ScheduledHealthPolicy"
        },
        "schema_version": {
          "default": "1.0",
          "description": "Schema MAJOR.MINOR this record was written against.",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "description": "One-line, agent-facing description used for discovery/search.",
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "test_requirements": {
          "description": "Paths/ids of promotion-gating tests this capability must pass, e.g. under windmill/tests/contracts/ (HF-015).",
          "items": {
            "type": "string"
          },
          "title": "Test Requirements",
          "type": "array"
        }
      },
      "required": [
        "path",
        "capability_version",
        "summary",
        "maturity",
        "owners"
      ],
      "title": "CapabilityMetadata",
      "type": "object"
    },
    "CatalogueEntry": {
      "description": "One discoverable capability: a Windmill script/flow plus its metadata.",
      "properties": {
        "input_kinds": {
          "description": "Controlled-vocabulary-by-convention short labels for what this capability consumes, e.g. ['resource:hermes_endpoint']. For HF-009's schema-compatibility search \u2014 exact-match only, not a real type system. Optional: an entry with none just never matches a kind-based search.",
          "items": {
            "type": "string"
          },
          "title": "Input Kinds",
          "type": "array"
        },
        "inputs_summary": {
          "description": "Short, agent-facing description of what this capability takes as input. Not the full argument schema \u2014 read that from Windmill via getScriptByPath/getFlowByPath using metadata.path.",
          "minLength": 1,
          "title": "Inputs Summary",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CapabilityKind"
        },
        "metadata": {
          "$ref": "#/$defs/CapabilityMetadata"
        },
        "output_kinds": {
          "description": "Same convention as input_kinds, for what this capability produces, e.g. ['model_list']. Lets one capability's output_kinds be matched against another's input_kinds for primitive-chaining searches.",
          "items": {
            "type": "string"
          },
          "title": "Output Kinds",
          "type": "array"
        },
        "outputs_summary": {
          "description": "Short, agent-facing description of what this capability returns.",
          "minLength": 1,
          "title": "Outputs Summary",
          "type": "string"
        },
        "tags": {
          "description": "Discovery keywords, e.g. ['web', 'fetch', 'read-only'].",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "inputs_summary",
        "outputs_summary",
        "metadata"
      ],
      "title": "CatalogueEntry",
      "type": "object"
    },
    "ScheduledHealthPolicy": {
      "description": "Opt-in bounds for metadata-driven live capability health checks.",
      "properties": {
        "cron": {
          "default": "0 0 * * * *",
          "minLength": 1,
          "title": "Cron",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "escalate_after_failures": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Escalate After Failures",
          "type": "integer"
        },
        "max_data_bytes": {
          "default": 1000000,
          "maximum": 100000000,
          "minimum": 1,
          "title": "Max Data Bytes",
          "type": "integer"
        },
        "max_samples_per_run": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Samples Per Run",
          "type": "integer"
        },
        "max_timeout_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Max Timeout Seconds",
          "type": "integer"
        },
        "rate_limit_per_minute": {
          "default": 1,
          "maximum": 1000,
          "minimum": 1,
          "title": "Rate Limit Per Minute",
          "type": "integer"
        },
        "timezone": {
          "default": "UTC",
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "ScheduledHealthPolicy",
      "type": "object"
    },
    "SearchQuery": {
      "description": "What to search for. See module docstring for filter vs. score semantics.",
      "properties": {
        "include_deprecated": {
          "default": false,
          "title": "Include Deprecated",
          "type": "boolean"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Restrict to script or flow only."
        },
        "max_effects": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapabilityEffects"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ceiling on acceptable effects \u2014 an entry with any effect True where max_effects has it False is excluded entirely, not just ranked lower."
        },
        "required_input_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Required Input Kinds",
          "type": "array"
        },
        "required_output_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Required Output Kinds",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tags": {
          "description": "Exact-match tags, scored not filtered.",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "task": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Free-text task description, matched by keyword overlap against each entry's summary/inputs_summary/outputs_summary/tags. Deterministic token overlap, not real semantic search \u2014 no embeddings, no LLM.",
          "title": "Task"
        }
      },
      "title": "SearchQuery",
      "type": "object"
    },
    "SearchResult": {
      "properties": {
        "entry": {
          "$ref": "#/$defs/CatalogueEntry"
        },
        "rationale": {
          "items": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "array"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "entry",
        "score"
      ],
      "title": "SearchResult",
      "type": "object"
    }
  },
  "properties": {
    "query": {
      "$ref": "#/$defs/SearchQuery"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/SearchResult"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "title": "SearchResponse",
  "type": "object"
}
